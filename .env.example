# Copy to .env to override docker-compose.yaml defaults.
POSTGRES_USER=dbsrv
POSTGRES_PASSWORD=dbsrv
POSTGRES_DB=dbsrv
POSTGRES_PORT=5432

# Used by cmd/xml-import and (later) cmd/dbsrv.
DATABASE_URL=postgres://dbsrv:dbsrv@localhost:5432/dbsrv
# Used by `go test ./internal/store/`. This database is WIPED on every run.
DBSRV_TEST_DSN=postgres://dbsrv:dbsrv@localhost:5432/dbsrv_test

# Private key of the secure client transport (required by every channel).
# Do not copy one from an example: create yours with
#   go run ./cmd/admin transport-key -env .env -pub "../wyd-others/Release Cliente/serverkey.txt"
# which also writes the public key the client needs (serverkey.txt).
# TMSRV_TRANSPORT_KEY=

# servidor.bat (optional)
# ADMIN_LISTEN=127.0.0.1:8080
# PUBLIC_LISTEN=:80             # serv00.htm, serverlist.bin + guild marks for the game client ("" = off)
# TMSRV_CHANNELS=1              # channels to start (numbers from tmsrv.yaml), e.g. "1 2"
# TMSRV_CONFIG=tmsrv.yaml       # settings file (on Windows, one with 127.0.0.N channel IPs)
# WYD_SERVER=1                  # server (group) of tmsrv.yaml this machine runs (DBSRV and TMSRV); only needed when it lists more than one
# ADMIN_USER=admin
# ADMIN_PASSWORD_HASH=          # from: bin\admin.exe hash-password
# DBSRV_MASTER_PASSWORD_HASH=
# DBSRV_ARGS=-debug
# TMSRV_ARGS=-debug
# ADMIN_ARGS=

# Registration page: the welcome email stays off until both are set.
# RESEND_API_KEY=
# RESEND_FROM=WYD <conta@seudominio.com>

# docker-compose (optional)
# (channel ports come from the channels list of tmsrv.yaml, one tmsrvN service each)
# POSTGRES_BIND=127.0.0.1       # host address Postgres is published on; the private IP when another VM runs a second server
# PUBLIC_PORT=80                # host port for serv00.htm, serverlist.bin + guild marks
# ADMIN_LISTEN=127.0.0.1:8080   # host address:port for the admin panel
# HOST_UID=1000                 # owner of files written to config/, guildmarks/, .admin-state/
# HOST_GID=1000
